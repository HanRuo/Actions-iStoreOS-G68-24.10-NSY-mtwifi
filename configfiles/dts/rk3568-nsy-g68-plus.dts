	cpu-supply = <&vdd_cpu>;
};

&cpu2 {
	cpu-supply = <&vdd_cpu>;
};

&cpu3 {
	cpu-supply = <&vdd_cpu>;
};

&tsadc {
	rockchip,hw-tshut-mode = <1>;
	rockchip,hw-tshut-polarity = <0>;
	status = "okay";
};

&uart2 {
	status = "okay";
};

&pcie30_phy_grf {
};

// 注意两条 pcie reset gpio 均与 NSY不同
// fe270000
// 这里需要更换uboot版本,因为只有支持的pcie拆分的才能启动这个
// 不然开启就挂死,更换版本:https://github.com/Kwiboo/u-boot-rockchip
// https://lists.denx.de/pipermail/u-boot/2023-August/525793.html
// 这个pcie,可能需要打补丁,使用radxa 版本
&pcie3x1 {
		vpcie3v3-supply = <&vcc3v3_pcie>;
		reset-gpios = <&gpio0 RK_PC3 GPIO_ACTIVE_HIGH>;
		num-lanes = <0x1>; /*可能不生效,但是拆分需要打补丁,如果是吧,打补丁*/
		pinctrl-0 = <&pcie30x1_reset_h>;
		status = "okay";
};

//fe280000
&pcie3x2 {
		vpcie3v3-supply = <&vcc3v3_pcie>;
		reset-gpios = <&gpio0 RK_PC6 GPIO_ACTIVE_HIGH>;
		num-lanes = <0x1>;
		pinctrl-0 = <&pcie30x2_reset_h>;
		rockchip,perst-inactive-ms = <500>;
		status = "okay";
};

&pcie30phy {
		data-lanes = <1 2>; //配置lan的通道树
		status = "okay";
};

&combphy2 {
		status = "okay";
};

&pcie2x1 {
		reset-gpios = <&gpio3 RK_PC1 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&pcie2x1_reset_h>;
		//for kernel.dts
		rockchip,perst-inactive-ms = <500>;
		status = "okay";
};

&gmac0 {
	assigned-clock-parents = <0x21 0x183 0x21 0xb6>;
	assigned-clock-rates = <0x00 0x7735940>;
	assigned-clocks = <0x21 0x185 0x21 0x182>;
	clock-names = "stmmaceth\0mac_clk_rx\0mac_clk_tx\0clk_mac_refout\0aclk_mac\0pclk_mac\0clk_mac_speed\0ptp_ref\0pclk_xpcs\0clk_xpcs_eee";
	clock_in_out = "output";
	clocks = <0x21 0x182 0x21 0x185 0x21 0x185 0x21 0xb8 0x21 0xb4 0x21 0xb5 0x21 0x185 0x21 0xb9 0x21 0xac 0x21 0xab>;
	compatible = "rockchip,rk3568-gmac\0snps,dwmac-4.20a";
	interrupt-names = "macirq\0eth_wake_irq";
	interrupts = <0x00 0x1b 0x04 0x00 0x18 0x04>;
	phy-mode = "rgmii-rxid";
	/* 修正：硬编码phandle替换为标准标签引用 */
	pinctrl-0 = <&gmac0_miim &gmac0_tx_bus2 &gmac0_rx_bus2 &gmac0_rgmii_clk &gmac0_rgmii_bus>;
	pinctrl-names = "default";
	reg = <0x00 0xfe2a0000 0x00 0x10000>;
	reset-names = "stmmaceth";
	resets = <0x21 0xd7>;
	rockchip,grf = <0x31>;
	snps,axi-config = <&gmac0_stmmac_axi_config>;
	snps,mixed-burst;
	snps,mtl-rx-config = <&gmac0_rx_queues_config>;
	snps,mtl-tx-config = <&gmac0_tx_queues_config>;
	snps,reset-active-low;
	snps,reset-delays-us = <0x00 0x4e20 0x186a0>;
	/* 修正：规范GPIO写法，不工作可改回<0x80 0x08 0x01> */
	snps,reset-gpio = <&gpio1 RK_PB0 GPIO_ACTIVE_LOW>;
	snps,tso;
	status = "okay";
	tx_delay = <0x3c>;

	fixed-link {
		full-duplex;
		pause;
		speed = <1000>;
	};

	mdio0: mdio {
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		compatible = "snps,dwmac-mdio";
	};

	/* 内部配置节点标签化 */
	gmac0_rx_queues_config: rx-queues-config {
		snps,rx-queues-to-use = <0x01>;
		queue0 { };
	};

	gmac0_stmmac_axi_config: stmmac-axi-config {
		snps,blen = <0x00 0x00 0x00 0x00 0x10 0x08 0x04>;
		snps,rd_osr_lmt = <0x08>;
		snps,wr_osr_lmt = <0x04>;
	};

	gmac0_tx_queues_config: tx-queues-config {
		snps,tx-queues-to-use = <0x01>;
		queue0 { };
	};
};

&gmac1 {
	assigned-clock-parents = <0x21 0x187 0x21 0xc5>;
	assigned-clock-rates = <0x00 0x7735940>;
	assigned-clocks = <0x21 0x189 0x21 0x186>;
	clock-names = "stmmaceth\0mac_clk_rx\0mac_clk_tx\0clk_mac_refout\0aclk_mac\0pclk_mac\0clk_mac_speed\0ptp_ref\0pclk_xpcs\0clk_xpcs_eee";
	clock_in_out = "output";
	clocks = <0x21 0x186 0x21 0x189 0x21 0x189 0x21 0xc7 0x21 0xc3 0x21 0xc4 0x21 0x189 0x21 0xc8 0x21 0xac 0x21 0xab>;
	compatible = "rockchip,rk3568-gmac\0snps,dwmac-4.20a";
	interrupt-names = "macirq\0eth_wake_irq";
	interrupts = <0x00 0x20 0x04 0x00 0x1d 0x04>;
	phy-mode = "rgmii-rxid";
	pinctrl-0 = <&gmac1m1_miim &gmac1m1_tx_bus2 &gmac1m1_rx_bus2 &gmac1m1_rgmii_clk &gmac1m1_rgmii_bus>;
	pinctrl-names = "default";
	reg = <0x00 0xfe010000 0x00 0x10000>;
	reset-names = "stmmaceth";
	resets = <0x21 0xec>;
	rockchip,grf = <0x31>;
	snps,axi-config = <&gmac1_stmmac_axi_config>;
	snps,mixed-burst;
	snps,mtl-rx-config = <&gmac1_rx_queues_config>;
	snps,mtl-tx-config = <&gmac1_tx_queues_config>;
	snps,reset-active-low;
	snps,reset-delays-us = <0x00 0x4e20 0x186a0>;
	/* 修正：规范GPIO写法，不工作可改回<0x80 0x09 0x01> */
	snps,reset-gpio = <&gpio2 RK_PC2 GPIO_ACTIVE_LOW>;
	snps,tso;
	status = "okay";
	tx_delay = <0x4f>;

	fixed-link {
		full-duplex;
		pause;
		speed = <1000>;
	};

	mdio {
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		compatible = "snps,dwmac-mdio";
	};

	gmac1_rx_queues_config: rx-queues-config {
		snps,rx-queues-to-use = <0x01>;
		queue0 { };
	};

	gmac1_stmmac_axi_config: stmmac-axi-config {
		snps,blen = <0x00 0x00 0x00 0x00 0x10 0x08 0x04>;
		snps,rd_osr_lmt = <0x08>;
		snps,wr_osr_lmt = <0x04>;
	};

	gmac1_tx_queues_config: tx-queues-config {
		snps,tx-queues-to-use = <0x01>;
		queue0 { };
	};
};



